{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main, spotlight and alert windows",
  "windows": [
    "main",
    "spotlight",
    "alert"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "updater:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
